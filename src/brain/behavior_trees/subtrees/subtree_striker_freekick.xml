<root BTCPP_format="4" >
   <include path="./subtree_cam_find_and_track_ball.xml" />
   <include path="./subtree_find_ball.xml" />
   <include path="./subtree_locate.xml" />
   <BehaviorTree ID="StrikerFreekick">
      <ReactiveSequence>
         <ReactiveSequence _while="gc_is_sub_state_kickoff_side" name="移动到开点球位置">
            <CamTrackBall _while="ball_location_known" />
            <SubTree ID="FindBall" _while="!(ball_location_known || tm_ball_pos_reliable)" _autoremap="true" />
            <ReactiveFallback _while="formation_enable &amp;&amp; (ball_location_known || tm_ball_pos_reliable)">
               <GoToFormationSlot scene="freekick_attack" vx_limit="0.7" vy_limit="0.4" />
               <GoToFreekickPosition side="attack" vx_limit="0.7" vy_limit="0.4" />
            </ReactiveFallback>
            <GoToFreekickPosition _while="!formation_enable &amp;&amp; (ball_location_known || tm_ball_pos_reliable)" side="attack" vx_limit="0.7" vy_limit="0.4" />
         </ReactiveSequence>
         <ReactiveSequence _while="!gc_is_sub_state_kickoff_side" name="移动到防守点球位置">
            <CamTrackBall _while="ball_location_known" />
            <SubTree ID="FindBall" _while="!(ball_location_known || tm_ball_pos_reliable)" _autoremap="true" />
            <ReactiveFallback _while="formation_enable &amp;&amp; (ball_location_known || tm_ball_pos_reliable)">
               <GoToFormationSlot scene="freekick_defense" />
               <GoToFreekickPosition side="defense" />
            </ReactiveFallback>
            <GoToFreekickPosition _while="!formation_enable &amp;&amp; (ball_location_known || tm_ball_pos_reliable)" side="defense" />
         </ReactiveSequence>
      </ReactiveSequence>
   </BehaviorTree>
</root>
